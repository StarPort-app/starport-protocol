{
  "name": "starport-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/node-protocol",
    "packages/node-agent",
    "packages/starlink-operator",
    "packages/read-only-client"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "build:contracts": "node contracts/build.mjs",
    "test:contracts": "npm run build:contracts && node --test contracts/test/vault.test.mjs",
    "prepare:fee-vault": "npm run build:contracts && node contracts/prepare-deployment.mjs"
  },
  "overrides": { "solc": { "tmp": "0.2.7" } },
  "devDependencies": {
    "@types/node": "26.6.3",
    "solc": "0.8.37",
    "typescript": "7.0.2",
    "viem": "2.56.9"
  }
}
